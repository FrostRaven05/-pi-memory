    "metadata_template": "{key}: {value}",
    "metadata_separator": "\n",
    "text": "登录会话有效期规则\n有效期长度\n- 管理后台的登录会话有效期为 30 分钟。\n- 计时方式：从签发时刻开始计算，30 分钟后到期。\n- 空闲会话不自动续期，必须由用户请求触发刷新。",
    "mimetype": "text/plain",
    "start_char_idx": null,
    "end_char_idx": null,
    "text_template": "{metadata_str}\n\n{content}",
    "class_name": "TextNode"
  },
  {
    "id_": "dcfc6331933d0ea723a0fbb815e4898bc8028973e859ac25755668789cb18228",
    "embedding": null,
    "metadata": {
      "file_path": "docs/session-rules.md",
      "heading": "到期边界",
      "source_hash": "bfa3dbaa5c7b1df408032cc94bb23745ddc5afaa0aa10b3eefb7afab6c4bccdb",
      "project_id": "login_demo",
      "generation": "20261102T031719-d6ea49c5"
    },
    "excluded_embed_metadata_keys": [
