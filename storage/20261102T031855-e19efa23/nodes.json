    "metadata_template": "{key}: {value}",
    "metadata_separator": "\n",
    "text": "登录会话有效期规则\n有效期长度\n- 管理后台的登录会话有效期为 20 分钟。\n- 计时方式：从签发时刻开始计算，20 分钟后到期。\n- 空闲会话不自动续期，必须由用户请求触发刷新。",
    "mimetype": "text/plain",
    "start_char_idx": null,
    "end_char_idx": null,
    "text_template": "{metadata_str}\n\n{content}",
    "class_name": "TextNode"
  },
