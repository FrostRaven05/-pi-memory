      "file_path": "docs/session-rules.md",
      "heading": "到期边界",
      "source_hash": "4708a8b0496597f05c2754374eee7ea4ad3822f7b76decfb1a014ddfda51f140",
      "project_id": "login_demo",
      "generation": "20261102T031855-e19efa23"
    },
